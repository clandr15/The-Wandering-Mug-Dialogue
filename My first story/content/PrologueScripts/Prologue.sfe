        },
        {
            "id": "9477d670c21348158d3a4711a0090b37",
            "position": {
                "x": 169.54674303828773,
                "y": -1.7763568394002505e-15
            },
            "type": "dialogue",
            "data": {
                "title": "Dialogue",
                "text": "Once upon a time, in a time of fairytales and fables, there was an ambitious child who dreamed of a bigger life. ",
                "options": [],
                "image": "",
                "imageReset": false,
                "character": "",
                "audio": "",
                "audioLoop": false,
                "audioReset": false,
                "audioAdvanceOnEnd": false,
                "audioAllowSkip": false,
                "imageUseVarInput": false,
                "characterUseVarInput": false,
                "audioUseVarInput": false,
                "textBlocks": [],
                "dialogueColor": "red"
            },
            "style": {
                "width": 256,
                "height": 237
            },
            "zIndex": 1,
            "measured": {
                "width": 256,
                "height": 237
            },
            "height": 237
        },
        {
            "id": "52c449bd9fc94f57b6aabef998870b10",
            "position": {
                "x": 467.2386979178239,
                "y": -1.7763568394002505e-15
            },
            "type": "dialogue",
            "data": {
                "title": "Dialogue",
                "text": "A life of purpose.\nA life of wonder. ",
                "options": [],
                "image": "",
                "imageReset": false,
                "character": "",
                "audio": "",
                "audioLoop": false,
                "audioReset": false,
                "audioAdvanceOnEnd": false,
                "audioAllowSkip": false,
                "imageUseVarInput": false,
                "characterUseVarInput": false,
                "audioUseVarInput": false
            },
            "style": {
                "width": 256,
                "height": 140
            },
            "zIndex": 1,
            "measured": {
                "width": 256,
                "height": 140
            }
        },
        {
            "id": "e82fd4ba505b4df78e96a6ac51a9d693",
            "position": {
                "x": 776.9514680775316,
                "y": -1.7763568394002505e-15
            },
            "type": "dialogue",
            "data": {
                "title": "Dialogue",
                "text": "But as the child grew, so too did their dream. They dreamed of a place where every stranger might have a story to tell. ",
                "options": [],
                "image": "",
                "imageReset": false,
                "character": "",
                "audio": "",
                "audioLoop": false,
                "audioReset": false,
                "audioAdvanceOnEnd": false,
                "audioAllowSkip": false,
                "imageUseVarInput": false,
                "characterUseVarInput": false,
                "audioUseVarInput": false,
                "textBlocks": []
            },
            "style": {
                "width": 256,
                "height": 201
            },
            "zIndex": 1,
            "measured": {
                "width": 256,
                "height": 201
            },
            "height": 201
        },
        {
            "id": "ecab1c30251a497298039376e11a2f7e",
            "position": {
                "x": 1092.3210924867315,
                "y": -1.7763568394002505e-15
            },
            "type": "dialogue",
            "data": {
                "title": "Dialogue",
                "text": "It was a dream so big, it seemed almost impossible to make true. Until one day, a scroll arrived. ",
                "options": [],
                "image": "",
                "imageReset": false,
                "character": "",
                "audio": "",
                "audioLoop": false,
                "audioReset": false,
                "audioAdvanceOnEnd": false,
                "audioAllowSkip": false,
                "imageUseVarInput": false,
                "characterUseVarInput": false,
                "audioUseVarInput": false
            },
            "style": {
                "width": 256,
                "height": 177
            },
            "zIndex": 1,
            "measured": {
                "width": 256,
                "height": 177
            },
            "height": 177
        },
        {
            "id": "f81e82413f7940bebdec7fe641227570",
            "position": {
                "x": 1399.8272061021585,
                "y": -1.7763568394002505e-15
            },
            "type": "dialogue",
            "data": {
                "title": "Dialogue",
                "text": "The scroll spoke of a distant relative. A relative the dreamer had never met. ",
                "options": [],
                "image": "",
                "imageReset": false,
                "character": "",
                "audio": "",
                "audioLoop": false,
                "audioReset": false,
                "audioAdvanceOnEnd": false,
                "audioAllowSkip": false,
                "imageUseVarInput": false,
                "characterUseVarInput": false,
                "audioUseVarInput": false
            },
            "style": {
                "width": 256,
                "height": 153
            },
            "zIndex": 1,
            "measured": {
                "width": 256,
                "height": 153
            },
            "height": 153
        },
        {
            "id": "801faa595f664de1aa4ca3b5f8de42ca",
            "position": {
                "x": 1709.4813307946579,
                "y": -1.7763568394002505e-15
            },
            "type": "dialogue",
            "data": {
                "title": "Dialogue",
                "text": "They had recently passed away, leaving behind a small tavern at the edge of the kingdom. ",
                "options": [],
                "image": "",
                "imageReset": false,
                "character": "",
                "audio": "",
                "audioLoop": false,
                "audioReset": false,
                "audioAdvanceOnEnd": false,
                "audioAllowSkip": false,
                "imageUseVarInput": false,
                "characterUseVarInput": false,
                "audioUseVarInput": false,
                "textBlocks": []
            },
            "style": {
                "width": 256,
                "height": 237
            },
            "zIndex": 1,
            "measured": {
                "width": 256,
                "height": 237
            },
            "height": 237
        },
        {
            "id": "ec28173156a14fbeba5a3429d3998df9",
            "position": {
                "x": 2030.8481410547224,
                "y": -1.7763568394002505e-15
            },
            "type": "dialogue",
            "data": {
                "title": "Dialogue",
                "text": "A place where travelers came to rest. ",
                "options": [],
                "image": "",
                "imageReset": false,
                "character": "",
                "audio": "",
                "audioLoop": false,
                "audioReset": false,
                "audioAdvanceOnEnd": false,
                "audioAllowSkip": false,
                "imageUseVarInput": false,
                "characterUseVarInput": false,
                "audioUseVarInput": false
            },
            "style": {
