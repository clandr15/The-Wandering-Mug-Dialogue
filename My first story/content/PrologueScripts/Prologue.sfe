                "y": -0.00004788723657789262
            },
            "type": "dialogue",
            "data": {
                "title": "Dialogue",
                "text": "A place where stories were shared. ",
                "options": [],
                "image": "",
                "imageReset": false,
                "character": "",
                "audio": "",
                "audioLoop": false,
                "audioReset": false,
                "audioAdvanceOnEnd": false,
