            },
            "type": "dialogue",
            "data": {
                "title": "Dialogue",
                "text": "A place where, perhaps, a dream might finally begin. ",
                "options": [],
                "image": "",
                "imageReset": false,
                "character": "",
                "audio": "",
                "audioLoop": false,
                "audioReset": false,
