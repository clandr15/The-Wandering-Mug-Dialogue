    "en": {
      "bffa64ceb3944c9db9793138eae0509e.title": "Dialogue",
      "bffa64ceb3944c9db9793138eae0509e.text": "You wake up in a mysterious forest. the morning mist swirls around ancient trees. Two paths stretch before you.",
      "a6f62813b9c549dd896fc341003586ce": "Take the left path.",
      "dea473344e8144a18e045142c2a101f2": "Take the right path. ",
      "0c8603a7899847b8a9163a41bf395655.title": "Left path",
      "0c8603a7899847b8a9163a41bf395655.text": "you take the left winding path. the trees grow denser, and you hear the sound of running water ahead. ",
      "f33a39ed20e34eddb28e1355da9f84e0.title": "Dialogue",
      "f33a39ed20e34eddb28e1355da9f84e0.text": "you venture down the right path. Sunlight breaks through the canopy, an dyou spot a small cottage...."
